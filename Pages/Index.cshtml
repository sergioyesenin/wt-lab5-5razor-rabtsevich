@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

<!-- HERO -->
<section class="hero-section text-white mb-5">
    <div class="container py-5">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="badge bg-light text-primary rounded-pill mb-3 px-3 py-2">
                    ✈️ WT-5 · Razor Pages
                </span>
                <h1 class="display-4 fw-bold mb-3">Управление авиаперевозками</h1>
                <p class="lead mb-4 opacity-75">
                    Единая система для авиакомпаний, воздушных судов и рейсов.
                    Разработано на ASP.NET Core Razor Pages с Bootstrap 5.
                </p>
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-page="/Flights/Index" class="btn btn-light btn-lg rounded-3 fw-semibold">
                        Каталог рейсов →
                    </a>
                    <a asp-page="/Airlines/Index" class="btn btn-outline-light btn-lg rounded-3">
                        Авиакомпании
                    </a>
                </div>
            </div>
            <div class="col-lg-5 text-center d-none d-lg-block">
                <div class="hero-illustration">
                    <i class="bi bi-airplane-engines" style="font-size: 12rem; opacity: .35;"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container pb-5">

    <!-- METRICS -->
    <div class="row g-4 mb-5">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 metric-card metric-blue">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Авиакомпаний</p>
                            <h2 class="fw-bold mb-0">@Model.AirlinesCount</h2>
                        </div>
                        <i class="bi bi-building fs-2 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 metric-card metric-purple">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Самолётов</p>
                            <h2 class="fw-bold mb-0">@Model.AircraftsCount</h2>
                        </div>
                        <i class="bi bi-airplane fs-2 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 metric-card metric-green">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Всего рейсов</p>
                            <h2 class="fw-bold mb-0">@Model.FlightsCount</h2>
                            <small class="text-success">Активных: @Model.ActiveFlightsCount</small>
                        </div>
                        <i class="bi bi-calendar-check fs-2 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 metric-card metric-orange">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Потенциал выручки</p>
                            <h2 class="fw-bold mb-0">@Model.TotalActiveRevenue.ToString("N0") ₽</h2>
                            <small class="text-muted">по активным рейсам</small>
                        </div>
                        <i class="bi bi-graph-up-arrow fs-2 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TWO COLUMNS -->
    <div class="row g-4">
        <!-- upcoming flights -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">🕓 Ближайшие рейсы</h5>
                        <a asp-page="/Flights/Index" class="btn btn-sm btn-outline-primary rounded-3">
                            Все рейсы
                        </a>
                    </div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Рейс</th>
                                    <th>Маршрут</th>
                                    <th>Вылет</th>
                                    <th class="text-end">Цена</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var f in Model.UpcomingFlights)
                            {
                                <tr>
                                    <td>
                                        <a asp-page="/Flights/Details" asp-route-id="@f.Id"
                                           class="fw-semibold text-decoration-none">@f.FlightNumber</a>
                                    </td>
                                    <td class="text-muted">@f.Departure → @f.Destination</td>
                                    <td><small>@f.DepartureTime.ToString("dd.MM HH:mm")</small></td>
                                    <td class="text-end fw-bold text-primary">@f.TicketPrice ₽</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- top airlines -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">⭐ Топ авиакомпаний</h5>
                    @foreach (var a in Model.TopAirlines)
                    {
                        <a asp-page="/Airlines/Details" asp-route-id="@a.Id"
                           class="d-flex align-items-center text-decoration-none text-dark mb-3 p-2 rounded-3 hover-row">
                            <div class="avatar-circle me-3">@a.IataCode</div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@a.Name</div>
                                <small class="text-muted">@a.Country</small>
                            </div>
                            <span class="badge bg-warning text-dark">@a.Rating ★</span>
                        </a>
                    }
                    <a asp-page="/Airlines/Index" class="btn btn-outline-secondary w-100 rounded-3 mt-2">
                        Все авиакомпании
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- QUICK LINKS -->
    <div class="row g-4 mt-1">
        <div class="col-md-4">
            <a asp-page="/Flights/Create" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 quick-action">
                    <div class="card-body p-4 text-center">
                        <i class="bi bi-plus-circle fs-1 text-primary mb-2"></i>
                        <h6 class="fw-bold mb-1">Добавить рейс</h6>
                        <small class="text-muted">Создать новый рейс</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-page="/Airlines/Create" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 quick-action">
                    <div class="card-body p-4 text-center">
                        <i class="bi bi-building-add fs-1 text-success mb-2"></i>
                        <h6 class="fw-bold mb-1">Новая авиакомпания</h6>
                        <small class="text-muted">Зарегистрировать перевозчика</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-page="/Aircrafts/Create" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 quick-action">
                    <div class="card-body p-4 text-center">
                        <i class="bi bi-airplane-engines fs-1 text-warning mb-2"></i>
                        <h6 class="fw-bold mb-1">Добавить самолёт</h6>
                        <small class="text-muted">Расширить парк ВС</small>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>