@page
@model wt_lab5_5razor_rabtsevich.Pages.Flights.IndexModel
@{
    ViewData["Title"] = "Рейсы";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="fw-bold mb-1">🗓 Каталог рейсов</h1>
            <p class="text-muted mb-0">Найдено: @Model.Flights.Count</p>
        </div>
        <a asp-page="/Flights/Create" class="btn btn-primary btn-lg rounded-3 shadow-sm">
            + Добавить рейс
        </a>
    </div>

    <!-- filters -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small text-muted mb-1">Поиск</label>
                    <input name="search" value="@Model.Search" class="form-control"
                           placeholder="Рейс, город…" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Авиакомпания</label>
                    <select name="airlineId" asp-items="Model.AirlineOptions" class="form-select">
                        <option value="">Все</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Тип</label>
                    <select name="flightType" class="form-select">
                        <option value="">Все</option>
                        @foreach (var t in Model.FlightTypes)
                        {
                            <option value="@t" selected="@(t == Model.FlightType)">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="onlyActive" value="true"
                               checked="@Model.OnlyActive" id="onlyActive" />
                        <label class="form-check-label small" for="onlyActive">Только активные</label>
                    </div>
                    <button class="btn btn-primary w-100">Найти</button>
                </div>
                <div class="col-12">
                    <a asp-page="/Flights/Index" class="btn btn-link btn-sm text-decoration-none">Сбросить фильтры</a>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Flights.Any())
    {
        <div class="alert alert-warning rounded-4">Рейсы не найдены.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var f in Model.Flights)
            {
                var airline = FlightStore.GetAirline(f.AirlineId);
                var aircraft = FlightStore.GetAircraft(f.AircraftId);
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 flight-card">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-secondary rounded-pill">ID: @f.Id</span>
                                <span class="badge rounded-pill @(f.IsActive ? "bg-success" : "bg-danger")">
                                    @(f.IsActive ? "Активен" : "Неактивен")
                                </span>
                            </div>
                            <h5 class="fw-bold mb-1">@f.FlightNumber</h5>
                            <p class="text-muted mb-2">
                                @f.Departure <i class="bi bi-arrow-right"></i> @f.Destination
                            </p>
                            <p class="small text-muted mb-1">
                                <i class="bi bi-building"></i> @airline?.Name
                            </p>
                            <p class="small text-muted mb-2">
                                <i class="bi bi-airplane"></i> @aircraft?.Model
                            </p>
                            <p class="mb-2"><small>🕓 @f.DepartureTime.ToString("dd.MM.yyyy HH:mm")</small></p>
                            <p class="mb-2">
                                Мест: <span class="badge bg-light text-dark">@f.SeatsAvailable</span>
                                <span class="badge bg-info text-dark">@f.FlightType</span>
                            </p>
                            <p class="fs-4 fw-bold text-primary mb-3">@f.TicketPrice ₽</p>

                            <div class="mt-auto d-flex gap-2">
                                <a asp-page="/Flights/Details" asp-route-id="@f.Id"
                                   class="btn btn-sm btn-outline-primary flex-fill rounded-3">Детали</a>
                                <a asp-page="/Flights/Edit" asp-route-id="@f.Id"
                                   class="btn btn-sm btn-outline-warning flex-fill rounded-3">Изменить</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@f.Id"
                                      onsubmit="return confirm('Удалить рейс?');" class="flex-fill">
                                    <button class="btn btn-sm btn-outline-danger w-100 rounded-3">Удалить</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>