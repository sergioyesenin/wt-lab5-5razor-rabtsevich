@page
@model ErrorModel
@{
    ViewData["Title"] = "Ошибка";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 text-center">
                <div class="card-body p-5">
                    <div class="display-1 fw-bold text-primary mb-2">@Model.Code</div>
                    <h2 class="fw-bold mb-3">@Model.Message</h2>
                    <p class="text-muted mb-4">
                        Если вы попали сюда по ссылке — возможно, объект был удалён
                        или параметры запроса некорректны.
                    </p>
                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                        <a asp-page="/Index" class="btn btn-primary rounded-3">На главную</a>
                        <a asp-page="/Flights/Index" class="btn btn-outline-secondary rounded-3">К рейсам</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>