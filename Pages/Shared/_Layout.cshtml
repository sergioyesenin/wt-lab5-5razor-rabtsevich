<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — WT-5 Razor Pages</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-page="/Index">✈️ FlightApp</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Index">
                            <i class="bi bi-house"></i> Главная
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Airlines/Index">
                            <i class="bi bi-building"></i> Авиакомпании
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Aircrafts/Index">
                            <i class="bi bi-airplane"></i> Самолёты
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Flights/Index">
                            <i class="bi bi-calendar-check"></i> Рейсы
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Flights/Create">
                            <i class="bi bi-plus-circle"></i> Добавить рейс
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-white border-top py-4 mt-auto">
        <div class="container">
            <div class="row align-items-center g-3">
                <div class="col-md-6 text-center text-md-start">
                    <div class="fw-bold">✈️ FlightApp</div>
                    <small class="text-muted">WT-5 · ASP.NET Core Razor Pages · @DateTime.Now.Year</small>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <small class="text-muted">
                        Авиакомпании · Самолёты · Рейсы
                    </small>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>