@page
@model wt_lab5_5razor_rabtsevich.Pages.Airlines.CreateModel
@{
    ViewData["Title"] = "Новая авиакомпания";
}

<div class="container py-4">
    <div class="card border-0 shadow-sm rounded-4 mx-auto" style="max-width: 720px;">
        <div class="card-body p-4 p-lg-5">
            <h2 class="fw-bold mb-4">🏢 Новая авиакомпания</h2>

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger rounded-3"></div>
            }

            <form method="post" novalidate>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Airline.Name" class="form-label"></label>
                        <input asp-for="Airline.Name" class="form-control" />
                        <span asp-validation-for="Airline.Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Airline.IataCode" class="form-label"></label>
                        <input asp-for="Airline.IataCode" class="form-control text-uppercase"
                               maxlength="3" placeholder="SU" />
                        <span asp-validation-for="Airline.IataCode" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Airline.Country" class="form-label"></label>
                        <input asp-for="Airline.Country" class="form-control" />
                        <span asp-validation-for="Airline.Country" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Airline.FoundedYear" class="form-label"></label>
                        <input asp-for="Airline.FoundedYear" type="number" class="form-control" />
                        <span asp-validation-for="Airline.FoundedYear" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Airline.Rating" class="form-label"></label>
                        <input asp-for="Airline.Rating" type="number" step="0.1" min="0" max="5"
                               class="form-control" />
                        <span asp-validation-for="Airline.Rating" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Airline.LogoUrl" class="form-label"></label>
                        <input asp-for="Airline.LogoUrl" type="url" class="form-control"
                               placeholder="https://..." />
                        <span asp-validation-for="Airline.LogoUrl" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Airline.Description" class="form-label"></label>
                        <textarea asp-for="Airline.Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Airline.Description" class="text-danger small"></span>
                    </div>
                    <div class="col-12 form-check ms-2">
                        <input asp-for="Airline.IsActive" class="form-check-input" />
                        <label asp-for="Airline.IsActive" class="form-check-label"></label>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary rounded-3">Сохранить</button>
                    <a asp-page="/Airlines/Index" class="btn btn-secondary rounded-3">← Назад</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}